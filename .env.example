# BiliTool.Vn - Environment Variables
# Sao chép file này thành .env và điền giá trị thực

# ── Database ──────────────────────────────────────────────────
DB_PASSWORD=change-this-database-password

# ── Google OAuth ──────────────────────────────────────────────
# Đăng ký tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Local Admin ───────────────────────────────────────────────
# Hash format: v1.<iterations>.<base64-salt>.<base64-pbkdf2-sha256>
ADMIN_USERNAME=administrator
ADMIN_PASSWORD_HASH=generate-a-pbkdf2-hash-before-deploy

# ── HIS Integration API ───────────────────────────────────────
# Dùng biến dạng ASP.NET Core array binding:
# Chỉ dùng trong giai đoạn migration. Production mới đặt false sau khi tạo HIS API client trong DB.
ApiSettings__EnableLegacyApiKeys=false
# ApiSettings__AllowedApiKeys__0=your-long-random-api-key
ApiSettings__AllowedApiKeys__0=change-this-long-random-api-key

# Bootstrap một lần để hash credential vào DB; xóa secret sau khi log báo thành công.
ApiSettings__BootstrapClient__TenantCode=hospital-demo
ApiSettings__BootstrapClient__TenantName=Hospital Demo
ApiSettings__BootstrapClient__ClientCode=his-main
ApiSettings__BootstrapClient__DisplayName=HIS Main Integration
ApiSettings__BootstrapClient__ApiKey=replace-with-at-least-32-random-characters
ApiSettings__BootstrapClient__Scopes=bilirubin:calculate bilirubin:metadata

# Reverse proxy nội bộ được phép gửi X-Forwarded-*.
ReverseProxy__KnownNetworks__0=172.16.0.0/12
