{
  "info": {
    "name": "BiliTool HIS-EMR Conformance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "REST v3 happy path",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{apiKey}}" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"source\":{\"system\":\"SANDBOX-HIS\",\"facility\":\"SANDBOX-FAC\",\"messageId\":\"postman-msg-001\"},\n  \"patient\":{\"identifier\":\"TEST-PATIENT-001\",\"assigningAuthority\":\"SANDBOX-FAC\",\"ageHours\":48,\"gestationalAgeWeeks\":38,\"phototherapyStatus\":\"none\"},\n  \"encounter\":{\"identifier\":\"TEST-ENC-001\"},\n  \"order\":{\"identifier\":\"TEST-ORDER-001\"},\n  \"specimen\":{\"identifier\":\"TEST-SPEC-001\",\"collectedAt\":\"2026-07-31T08:00:00Z\"},\n  \"observation\":{\"identifier\":\"TEST-OBS-001\",\"effectiveAt\":\"2026-07-31T08:00:00Z\",\"value\":12,\"unit\":\"mg/dL\"},\n  \"riskFactors\":{}\n}" },
        "url": "{{baseUrl}}/api/v3/clinical/bilirubin/calculate"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.test('resultId', () => pm.expect(pm.response.json().resultId).to.exist);"] } }]
    },
    {
      "name": "REST v3 duplicate replay",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{apiKey}}" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"source\":{\"system\":\"SANDBOX-HIS\",\"facility\":\"SANDBOX-FAC\",\"messageId\":\"postman-msg-001\"},\"patient\":{\"identifier\":\"TEST-PATIENT-001\",\"assigningAuthority\":\"SANDBOX-FAC\",\"ageHours\":48,\"gestationalAgeWeeks\":38,\"phototherapyStatus\":\"none\"},\"encounter\":{\"identifier\":\"TEST-ENC-001\"},\"order\":{\"identifier\":\"TEST-ORDER-001\"},\"specimen\":{\"identifier\":\"TEST-SPEC-001\",\"collectedAt\":\"2026-07-31T08:00:00Z\"},\"observation\":{\"identifier\":\"TEST-OBS-001\",\"effectiveAt\":\"2026-07-31T08:00:00Z\",\"value\":12,\"unit\":\"mg/dL\"},\"riskFactors\":{}}" },
        "url": "{{baseUrl}}/api/v3/clinical/bilirubin/calculate"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('replayed', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));"] } }]
    }
  ]
}
