@code {
    private static string L(string vi, string en, string fr)
    {
        var language = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLowerInvariant();
        return language switch
        {
            "en" => en,
            "fr" => fr,
            _ => vi
        };
    }
