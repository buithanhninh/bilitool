@page "/tich-hop-his"
@using System.Globalization

@{
    var pageTitle = L(
        "Tích hợp HIS / EMR Production — REST v3, FHIR R4, HL7 v2.5.1 | BiliTool.Vn",
        "Production HIS / EMR Integration — REST v3, FHIR R4, HL7 v2.5.1 | BiliTool.Vn",
        "Intégration HIS / EMR Production — REST v3, FHIR R4, HL7 v2.5.1 | BiliTool.Vn");
    var pageDescription = L(
        "Tài liệu tích hợp HIS/EMR production của BiliTool.Vn: REST API v3, FHIR R4, HL7 v2.5.1, Deep Link, webhook, tenant credential, idempotency, mTLS, lỗi chuẩn và sandbox.",
        "Production HIS/EMR integration guide for BiliTool.Vn: REST API v3, FHIR R4, HL7 v2.5.1, Deep Link, webhooks, tenant credentials, idempotency, mTLS, standard errors, and sandbox onboarding.",
        "Guide d’intégration HIS/EMR production de BiliTool.Vn : REST API v3, FHIR R4, HL7 v2.5.1, lien profond, webhooks, identifiants tenant, idempotence, mTLS, erreurs standard et sandbox.");
}

<PageTitle>@pageTitle</PageTitle>
<HeadContent>
    <meta name="description" content="@pageDescription" />
    <meta name="keywords" content="BiliTool.Vn HIS EMR API, REST v3, FHIR R4, HL7 v2.5.1, neonatal bilirubin integration, hospital interoperability" />
    <SeoLanguageLinks Path="/tich-hop-his" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="https://bilitool.vn/tich-hop-his" />
    <meta property="og:site_name" content="BiliTool.Vn" />
    <meta property="og:image" content="https://bilitool.vn/images/og-bilitool-1200x630.png" />
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

<div class="his-doc-shell">
    <section class="his-hero-panel">
        <div class="his-kicker"><i class="fas fa-hospital-alt"></i> HIS / EMR Production Integration · v1.4.2</div>
        <h1>@L("Tích hợp bệnh viện theo contract production", "Hospital integration built on a production contract", "Intégration hospitalière fondée sur un contrat production")</h1>
        <p>
            @L(
                "BiliTool.Vn cung cấp một bề mặt tích hợp thống nhất cho HIS, EMR và LIS: REST API v3 là contract JSON canonical; FHIR R4 và HL7 v2.5.1 dùng cùng clinical engine; Deep Link dành cho quy trình có bác sĩ kiểm tra; webhook phát sự kiện bất đồng bộ.",
                "BiliTool.Vn exposes one consistent integration surface for HIS, EMR, and LIS systems: REST API v3 is the canonical JSON contract; FHIR R4 and HL7 v2.5.1 use the same clinical engine; Deep Link supports clinician-reviewed workflows; webhooks publish asynchronous events.",
                "BiliTool.Vn expose une surface d’intégration cohérente pour les systèmes HIS, EMR et LIS : REST API v3 constitue le contrat JSON canonique ; FHIR R4 et HL7 v2.5.1 utilisent le même moteur clinique ; le lien profond convient aux flux revus par un clinicien ; les webhooks publient les événements asynchrones.")
        </p>
        <div class="his-status-grid" aria-label="Integration overview">
            <div><strong>@L("Protocols", "Protocols", "Protocoles")</strong><span>REST v3 · FHIR R4 · HL7 v2.5.1 · Deep Link</span></div>
            <div><strong>@L("Định danh", "Identity", "Identité")</strong><span>Tenant/client <code>X-API-Key</code> · optional mTLS</span></div>
            <div><strong>@L("Tin cậy", "Reliability", "Fiabilité")</strong><span>Idempotency · correlation · timeout · rate limit</span></div>
            <div><strong>@L("Phạm vi runtime", "Runtime scope", "Périmètre runtime")</strong><span>35–45 @L("tuần", "weeks", "semaines") · 1–336 @L("giờ", "hours", "heures")</span></div>
        </div>
        <nav class="his-nav-grid" aria-label="Integration guide sections">
            <a href="#rest-v3">REST v3</a>
            <a href="#fhir-r4">FHIR R4</a>
            <a href="#hl7-v251">HL7 v2.5.1</a>
            <a href="#security">@L("Bảo mật", "Security", "Sécurité")</a>
            <a href="#webhooks">Webhooks</a>
            <a href="#sandbox">Sandbox</a>
            <a href="#legacy">Legacy v1/v2</a>
        </nav>
    </section>

    <section class="his-audit-card">
        <h2>@L("Chọn phương thức tích hợp", "Choose an integration method", "Choisir une méthode d’intégration")</h2>
        <div class="table-responsive" tabindex="0">
            <table class="his-table">
                <thead>
                    <tr>
                        <th>@L("Phương thức", "Method", "Méthode")</th>
                        <th>@L("Dùng khi", "Use when", "Utilisation")</th>
                        <th>@L("Contract", "Contract", "Contrat")</th>
                        <th>@L("Trạng thái", "Status", "Statut")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td><strong>REST API v3</strong></td><td>@L("HIS cần JSON ổn định, machine-readable và lưu kết quả có provenance.", "The HIS needs stable machine-readable JSON and provenance-aware results.", "Le HIS nécessite un JSON stable, lisible par machine, avec provenance.")</td><td><code>POST /api/v3/clinical/bilirubin/calculate</code></td><td><span class="his-badge canonical">Canonical</span></td></tr>
                    <tr><td><strong>FHIR R4</strong></td><td>@L("Hệ thống dùng Patient, Encounter, ServiceRequest, Specimen và Observation.", "The system exchanges Patient, Encounter, ServiceRequest, Specimen, and Observation resources.", "Le système échange les ressources Patient, Encounter, ServiceRequest, Specimen et Observation.")</td><td><code>Bundle</code> / <code>OperationOutcome</code></td><td><span class="his-badge production">Production</span></td></tr>
                    <tr><td><strong>HL7 v2.5.1</strong></td><td>@L("LIS/HIS gửi ORU^R01 và cần ACK đồng bộ.", "The LIS/HIS sends ORU^R01 and requires a synchronous ACK.", "Le LIS/HIS envoie ORU^R01 et exige un ACK synchrone.")</td><td><code>ORU^R01</code> / <code>ACK</code></td><td><span class="his-badge production">Production</span></td></tr>
                    <tr><td><strong>Deep Link</strong></td><td>@L("Bác sĩ cần mở giao diện, kiểm tra dữ liệu rồi mới tính.", "A clinician must open the UI, review inputs, and calculate.", "Un clinicien doit ouvrir l’interface, vérifier les données puis calculer.")</td><td><code>GET /may-tinh?... </code></td><td><span class="his-badge ui">UI workflow</span></td></tr>
                    <tr><td><strong>Webhook</strong></td><td>@L("Đối tác nhận sự kiện calculation completed bất đồng bộ.", "A partner receives calculation-completed events asynchronously.", "Un partenaire reçoit les événements de calcul terminé de façon asynchrone.")</td><td>HMAC-SHA256 over HTTPS</td><td><span class="his-badge production">Production</span></td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="his-method-card" id="rest-v3">
        <div class="his-method-heading"><span>@L("Khuyến nghị cho tích hợp mới", "Recommended for new integrations", "Recommandé pour les nouvelles intégrations")</span><h2>REST API v3 canonical</h2></div>
        <p>@L("Mọi tích hợp JSON mới phải dùng v3. Contract từ chối field không công bố, dùng timestamp có timezone, UCUM units và trả provenance đầy đủ.", "All new JSON integrations must use v3. The contract rejects undocumented fields, uses timezone-aware timestamps and UCUM units, and returns complete provenance.", "Toute nouvelle intégration JSON doit utiliser v3. Le contrat rejette les champs non documentés, utilise des horodatages avec fuseau et des unités UCUM, puis renvoie une provenance complète.")</p>
        <div class="his-endpoint" tabindex="0"><code>POST</code><span>https://bilitool.vn/api/v3/clinical/bilirubin/calculate</span></div>

        <h3>@L("Headers bắt buộc", "Required headers", "En-têtes requis")</h3>
        <pre tabindex="0"><code>Content-Type: application/json
X-API-Key: &lt;tenant-client-credential&gt;
Idempotency-Key: &lt;unique-request-key&gt;
X-Correlation-ID: &lt;optional-correlation-id&gt;</code></pre>
        <p class="his-note"><i class="fas fa-code"></i><span>@L("OpenAPI 3.1.1:", "OpenAPI 3.1.1:", "OpenAPI 3.1.1 :") <a href="/openapi/v3.json" target="_blank" rel="noopener">/openapi/v3.json</a> · <a href="/openapi" target="_blank" rel="noopener">@L("Giao diện tương tác", "Interactive UI", "Interface interactive")</a>.</span></p>

        <h3>@L("Canonical request", "Canonical request", "Requête canonique")</h3>
        <pre tabindex="0"><code>{
  "source": {
    "system": "HIS-A",
    "facility": "FAC-A",
    "messageId": "msg-001"
  },
  "patient": {
    "identifier": "patient-001",
    "assigningAuthority": "FAC-A",
    "birthTime": null,
    "ageHours": 48,
    "gestationalAgeWeeks": 38,
    "phototherapyStatus": "none"
  },
  "encounter": { "identifier": "enc-001" },
  "order": { "identifier": "order-001" },
  "specimen": {
    "identifier": "spec-001",
    "collectedAt": "2026-08-03T08:00:00+07:00"
  },
  "observation": {
    "identifier": "obs-001",
    "effectiveAt": "2026-08-03T08:00:00+07:00",
    "value": 12.5,
    "unit": "mg/dL"
  },
  "riskFactors": {}
}</code></pre>
        <p>@L("Đơn vị chỉ nhận", "Accepted units are", "Les unités acceptées sont") <code>mg/dL</code> @L("hoặc", "or", "ou") <code>umol/L</code>. <code>phototherapyStatus</code>: <code>none</code>, <code>phototherapy</code>, <code>intensive-phototherapy</code>, <code>stopped</code>.</p>

        <h3>@L("Response ổn định", "Stable response groups", "Groupes de réponse stables")</h3>
        <div class="table-responsive" tabindex="0">
            <table class="his-table">
                <thead><tr><th>@L("Nhóm", "Group", "Groupe")</th><th>@L("Nội dung", "Content", "Contenu")</th></tr></thead>
                <tbody>
                    <tr><td><code>resultId</code>, <code>correlationId</code></td><td>@L("Định danh kết quả và truy vết request.", "Result identity and request traceability.", "Identité du résultat et traçabilité de la requête.")</td></tr>
                    <tr><td><code>references</code></td><td>@L("Message, patient, encounter, order, specimen và observation IDs.", "Message, patient, encounter, order, specimen, and observation IDs.", "Identifiants message, patient, encounter, order, specimen et observation.")</td></tr>
                    <tr><td><code>provenance</code></td><td>@L("Guideline revision/effective date, engine version, dataset revision và decision protocol.", "Guideline revision/effective date, engine version, dataset revision, and decision protocol.", "Révision/date d’effet du guide, version du moteur, révision du dataset et protocole de décision.")</td></tr>
                    <tr><td><code>observation</code>, <code>thresholds</code></td><td>@L("Dữ liệu đã chuẩn hóa và ngưỡng có đơn vị rõ ràng.", "Normalized values and explicitly unit-labeled thresholds.", "Valeurs normalisées et seuils avec unités explicites.")</td></tr>
                    <tr><td><code>recommendation</code></td><td>@L("Mức cảnh báo, can thiệp và thời điểm đo lại.", "Alert level, intervention flags, and repeat-measurement timing.", "Niveau d’alerte, interventions et délai de nouveau dosage.")</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="his-method-card" id="fhir-r4">
        <div class="his-method-heading"><span>FHIR R4</span><h2>@L("FHIR operation và Implementation Guide", "FHIR operation and Implementation Guide", "Opération FHIR et guide d’implémentation")</h2></div>
        <div class="his-endpoint" tabindex="0"><code>GET</code><span>https://bilitool.vn/api/v3/fhir/R4/metadata</span></div>
        <div class="his-endpoint" tabindex="0"><code>POST</code><span>https://bilitool.vn/api/v3/fhir/R4/$bilirubin-calculate</span></div>
        <ul class="his-check-list">
            <li><i class="fas fa-check"></i><span>@L("Input là", "Input is a", "L’entrée est un") <code>Bundle.type=transaction</code> @L("gồm đúng một", "with exactly one", "contenant exactement une ressource de chaque type") <code>Patient</code>, <code>Encounter</code>, <code>ServiceRequest</code>, <code>Specimen</code>, <code>Observation</code>.</span></li>
            <li><i class="fas fa-check"></i><span><code>Observation.code</code> @L("dùng LOINC", "uses LOINC", "utilise LOINC") <code>1975-2</code> @L("hoặc", "or", "ou") <code>14631-6</code>; <code>valueQuantity</code> @L("dùng UCUM", "uses UCUM", "utilise UCUM").</span></li>
            <li><i class="fas fa-check"></i><span>@L("Response là Bundle collection chứa derived Observation và DiagnosticReport.", "The response is a collection Bundle containing a derived Observation and DiagnosticReport.", "La réponse est un Bundle collection contenant une Observation dérivée et un DiagnosticReport.")</span></li>
            <li><i class="fas fa-check"></i><span>@L("Lỗi validation trả", "Validation errors return", "Les erreurs de validation renvoient") <code>OperationOutcome</code> @L("với", "with", "avec") <code>application/fhir+json</code>.</span></li>
        </ul>
        <p class="his-note"><i class="fas fa-link"></i><span>@L("Chi tiết profile và extensions:", "Profiles and extension details:", "Détails des profils et extensions :") <a href="https://github.com/buithanhninh/bilitool/blob/main/docs/integration/fhir-r4.md" target="_blank" rel="noopener">FHIR R4 Implementation Guide</a>.</span></p>
    </section>

    <section class="his-method-card" id="hl7-v251">
        <div class="his-method-heading"><span>HL7 v2.5.1</span><h2>ORU^R01 → ACK AA/AE</h2></div>
        <div class="his-endpoint" tabindex="0"><code>POST</code><span>https://bilitool.vn/api/v3/hl7/v251/oru-r01</span></div>
        <pre tabindex="0"><code>Content-Type: application/hl7-v2
X-API-Key: &lt;tenant-client-credential&gt;
Idempotency-Key: &lt;MSH-10&gt;</code></pre>
        <div class="table-responsive" tabindex="0">
            <table class="his-table">
                <thead><tr><th>@L("Segment", "Segment", "Segment")</th><th>@L("Mapping bắt buộc", "Required mapping", "Mapping requis")</th></tr></thead>
                <tbody>
                    <tr><td><code>MSH</code></td><td><code>MSH-9=ORU^R01^ORU_R01</code>, <code>MSH-10</code> unique, <code>MSH-12=2.5.1</code>.</td></tr>
                    <tr><td><code>PID / PV1</code></td><td><code>PID-3</code> patient + assigning authority; <code>PV1-19</code> encounter.</td></tr>
                    <tr><td><code>ORC / OBR</code></td><td><code>ORC-2</code> order; <code>OBR-3</code> specimen/accession; <code>OBR-7</code> collection time.</td></tr>
                    <tr><td><code>OBX</code></td><td>LOINC bilirubin, numeric value, UCUM unit, observation time; local <code>99BILITOOL</code> OBX codes for age, gestation, phototherapy and risk factors.</td></tr>
                    <tr><td><code>ACK</code></td><td><code>MSA-1=AA</code> @L("khi thành công;", "on success;", "en cas de succès ;") <code>AE</code> @L("khi lỗi validation/application; ACK thành công có", "for validation/application errors; successful ACK includes", "pour les erreurs de validation/application ; un ACK réussi contient") <code>ZBR</code>.</td></tr>
                </tbody>
            </table>
        </div>
        <p class="his-note warning"><i class="fas fa-triangle-exclamation"></i><span><code>Idempotency-Key</code> @L("phải bằng", "must equal", "doit être égal à") <code>MSH-10</code>. @L("Cùng key nhưng khác message bị từ chối.", "Reusing the key with a different message is rejected.", "La réutilisation de la clé avec un message différent est rejetée.")</span></p>
    </section>

    <section class="his-method-card" id="security">
        <div class="his-method-heading"><span>@L("Security & reliability", "Security & reliability", "Sécurité et fiabilité")</span><h2>@L("Yêu cầu bắt buộc cho production client", "Mandatory production client requirements", "Exigences obligatoires pour les clients production")</h2></div>
        <ul class="his-check-list">
            <li><i class="fas fa-key"></i><span><strong>Tenant/client credential.</strong> <code>X-API-Key</code> @L("được hash khi lưu, có scope, expiry, revoke và dual-key rotation.", "is stored as a hash and supports scopes, expiry, revocation, and dual-key rotation.", "est stockée sous forme de hash et prend en charge scopes, expiration, révocation et rotation à deux clés.")</span></li>
            <li><i class="fas fa-certificate"></i><span><strong>Optional mTLS.</strong> @L("Client bật", "Clients configured with", "Les clients configurés avec") <code>RequireMutualTls=true</code> @L("phải gửi certificate có SHA-256 fingerprint khớp registry.", "must present a certificate whose SHA-256 fingerprint matches the registry.", "doivent présenter un certificat dont l’empreinte SHA-256 correspond au registre.")</span></li>
            <li><i class="fas fa-copy"></i><span><strong>Idempotency.</strong> <code>Idempotency-Key</code> 8–128 @L("ký tự", "characters", "caractères") <code>A-Z a-z 0-9 - _ .</code>; @L("retry cùng payload trả lại cùng response và media type.", "retrying the same payload replays the same response and media type.", "la répétition du même payload rejoue la même réponse et le même type média.")</span></li>
            <li><i class="fas fa-link"></i><span><strong>Correlation.</strong> <code>X-Correlation-ID</code> @L("tối đa 64 ký tự; response luôn trả correlation ID để đối soát log/audit.", "is limited to 64 characters; responses always expose a correlation ID for log and audit reconciliation.", "est limité à 64 caractères ; les réponses exposent toujours un identifiant de corrélation pour les logs et audits.")</span></li>
            <li><i class="fas fa-gauge-high"></i><span><strong>Rate limit.</strong> @L("Mặc định", "Default", "Valeur par défaut") <code>30 request / 60 seconds</code> @L("theo client fingerprint; response 429 có Retry-After.", "per client fingerprint; 429 responses include Retry-After.", "par empreinte client ; les réponses 429 incluent Retry-After.")</span></li>
            <li><i class="fas fa-file-shield"></i><span><strong>Payload limits.</strong> REST v3: <code>64 KiB</code>; FHIR/HL7: <code>128 KiB</code>. @L("Vượt giới hạn trả", "Oversized requests return", "Les requêtes trop volumineuses renvoient") <code>413 request_too_large</code>.</span></li>
        </ul>
    </section>

    <section class="his-method-card his-error-card" id="errors">
        <div class="his-method-heading"><span>@L("Machine-readable errors", "Machine-readable errors", "Erreurs lisibles par machine")</span><h2>RFC 9457 <code>application/problem+json</code></h2></div>
        <p>@L("REST v3 errors luôn có", "REST v3 errors always include", "Les erreurs REST v3 contiennent toujours") <code>errorCode</code>, <code>correlationId</code>, <code>retryable</code> @L("và", "and", "et") <code>errors</code> @L("khi có lỗi theo field.", "for field-level validation failures.", "pour les erreurs de validation par champ.")</p>
        <div class="his-error-grid">
            <div><strong>400</strong><span><code>invalid_json</code>, <code>invalid_request</code>, <code>clinical_validation_failed</code>.</span></div>
            <div><strong>401</strong><span><code>missing_api_key</code>, <code>invalid_api_key</code>.</span></div>
            <div><strong>403</strong><span><code>insufficient_scope</code> @L("hoặc mTLS policy không đạt.", "or an unmet mTLS policy.", "ou politique mTLS non satisfaite.")</span></div>
            <div><strong>409</strong><span><code>idempotency_payload_conflict</code>, <code>idempotency_request_in_progress</code>.</span></div>
            <div><strong>413</strong><span><code>request_too_large</code>.</span></div>
            <div><strong>429</strong><span><code>rate_limit_exceeded</code>; @L("retry theo", "retry according to", "réessayer selon") <code>Retry-After</code>.</span></div>
            <div><strong>500</strong><span><code>clinical_calculation_failed</code>; @L("đối soát bằng correlation ID.", "reconcile using the correlation ID.", "corréler avec l’identifiant de corrélation.")</span></div>
            <div><strong>503</strong><span><code>tenant_rollout_disabled</code> @L("hoặc emergency kill switch.", "or the emergency kill switch.", "ou arrêt d’urgence.")</span></div>
        </div>
    </section>

    <section class="his-method-card" id="webhooks">
        <div class="his-method-heading"><span>Webhook outbox</span><h2><code>clinical.calculation.completed</code></h2></div>
        <p>@L("Clinical audit và outbox event được lưu cùng transaction; request không chờ webhook delivery. Endpoint đối tác phải dùng HTTPS và xác minh HMAC-SHA256 trên exact body.", "Clinical audit and outbox events are persisted in the same transaction; requests do not wait for webhook delivery. Partner endpoints must use HTTPS and verify HMAC-SHA256 over the exact body.", "L’audit clinique et l’événement outbox sont persistés dans la même transaction ; la requête n’attend pas la livraison du webhook. Le endpoint partenaire doit utiliser HTTPS et vérifier HMAC-SHA256 sur le corps exact.")</p>
        <pre tabindex="0"><code>X-BiliTool-Event-Id: &lt;outbox-event-guid&gt;
X-BiliTool-Event-Type: clinical.calculation.completed
X-BiliTool-Timestamp: &lt;unix-seconds&gt;
X-BiliTool-Signature: v1=&lt;hmac-sha256-hex&gt;</code></pre>
        <ul class="his-check-list">
            <li><i class="fas fa-clock"></i><span>@L("Delivery timeout 10 giây, connect timeout 5 giây, exponential backoff và tối đa 8 lần thử.", "Delivery timeout is 10 seconds, connect timeout is 5 seconds, with exponential backoff and up to 8 attempts.", "Timeout de livraison de 10 secondes, connexion de 5 secondes, backoff exponentiel et jusqu’à 8 tentatives.")</span></li>
            <li><i class="fas fa-triangle-exclamation"></i><span>@L("Sau retry budget, event chuyển DeadLetter; admin replay được audit.", "After the retry budget, events move to DeadLetter; administrative replay is audited.", "Après épuisement des tentatives, l’événement passe en DeadLetter ; le replay administratif est audité.")</span></li>
            <li><i class="fas fa-shield-alt"></i><span>@L("Production chặn loopback, link-local, private IP/DNS và redirect để giảm SSRF.", "Production blocks loopback, link-local, private IP/DNS targets, and redirects to reduce SSRF risk.", "La production bloque loopback, link-local, IP/DNS privés et redirections pour réduire le risque SSRF.")</span></li>
        </ul>
    </section>

    <section class="his-method-card" id="sandbox">
        <div class="his-method-heading"><span>@L("Onboarding", "Onboarding", "Onboarding")</span><h2>@L("Kiểm thử trước khi kết nối bệnh viện", "Test before connecting a hospital", "Tester avant la connexion à l’hôpital")</h2></div>
        <div class="his-risk-grid">
            <div><h4>Docker sandbox</h4><p>@L("Dựng PostgreSQL và API cô lập với synthetic fixtures; không dùng production PHI.", "Starts isolated PostgreSQL and API services with synthetic fixtures; never use production PHI.", "Démarre PostgreSQL et l’API isolés avec données synthétiques ; ne jamais utiliser de PHI production.")</p><pre tabindex="0"><code>cd sandbox
docker compose up --build</code></pre></div>
